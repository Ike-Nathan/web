# Optional: URL of the stellar-txwatch-core API
# Leave empty to use localStorage-only mode
# Examples:
#   Local development: http://localhost:8000
#   Staging: https://api-staging.example.com
#   Production: https://api.example.com
NEXT_PUBLIC_API_URL=

# Enable HSTS only for production deployments served over HTTPS
ENABLE_HSTS=true

# Optional: Soroban RPC endpoint overrides
# Per-network variables win over the global one; defaults to official endpoints.
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=
# NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=
# NEXT_PUBLIC_SOROBAN_RPC_URL_FUTURENET=

# Optional: Horizon API endpoint overrides
# Per-network variables win over the global one; defaults to official endpoints.
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_HORIZON_URL_MAINNET=
# NEXT_PUBLIC_HORIZON_URL_TESTNET=
# NEXT_PUBLIC_HORIZON_URL_FUTURENET=
