# Optional: URL of the stellar-txwatch-core API
# Leave empty to use localStorage-only mode
# Examples:
#   Local development: http://localhost:8000
#   Staging: https://api-staging.example.com
#   Production: https://api.example.com
NEXT_PUBLIC_API_URL=

# Enable HSTS only for production deployments served over HTTPS
ENABLE_HSTS=true

# Optional: Soroban RPC endpoint overrides
# Per-network variables win over the global one; defaults to official endpoints.
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=
# NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=
# NEXT_PUBLIC_SOROBAN_RPC_URL_FUTURENET=

# Optional: block-explorer link templates for transactions and contracts.
# Placeholders: {network} becomes public (mainnet), testnet or futurenet
# (or a custom network's name); {hash} becomes the tx hash or contract ID.
# Must be http(s) URLs containing {hash}; otherwise stellar.expert is used.
# Custom networks only get explorer links when these are set.
# NEXT_PUBLIC_EXPLORER_URL_TEMPLATE_TX=https://stellar.expert/explorer/{network}/tx/{hash}
# NEXT_PUBLIC_EXPLORER_URL_TEMPLATE_CONTRACT=https://stellar.expert/explorer/{network}/contract/{hash}

# Optional: Horizon API endpoint overrides
# Per-network variables win over the global one; defaults to official endpoints.
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_HORIZON_URL_MAINNET=
# NEXT_PUBLIC_HORIZON_URL_TESTNET=
# NEXT_PUBLIC_HORIZON_URL_FUTURENET=
